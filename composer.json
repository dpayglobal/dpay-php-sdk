{
    "name": "dpayglobal/dpay-php-sdk",
    "description": "Official dpay.pl PHP SDK",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["dpay", "payments", "blik", "cards", "sdk"],
    "homepage": "https://dpay.pl",
    "authors": [
        {
            "name": "dpay",
            "homepage": "https://dpay.pl"
        }
    ],
    "support": {
        "docs": "https://docs.dpay.pl",
        "issues": "https://github.com/dpayglobal/dpay-php-library-src/issues"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "DPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
